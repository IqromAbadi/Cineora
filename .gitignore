#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment secrets (Envied). env.g.dart holds the obfuscated API key.
.env
.env.*
!.env.example
lib/app/core/config/env.g.dart

# Signing material and service credentials
key.properties
*.keystore
*.jks
*.p12
*.p8
*.pem
*.mobileprovision
*.cer
google-services.json
GoogleService-Info.plist

# Build outputs that can carry a baked-in API key
*.apk
*.aab
*.ipa
*.dSYM.zip

# Local tooling
.fvm/
.vscode/settings.json
